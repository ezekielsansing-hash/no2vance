# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. Required for the contract acceptance pages, which are opened by
# customers who are not signed in. Supabase Dashboard > Project Settings > API >
# "service_role" key. This bypasses all row-level security — never expose it to
# the browser, and never add a NEXT_PUBLIC_ prefix to it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- QuickBooks (Intuit) ---
# developer.intuit.com > your app > Keys & Credentials.
# Use the Development pair while building against the sandbox company; swap in
# the Production pair once Intuit issues production keys.
# The secret is server-only — never give either of these a NEXT_PUBLIC_ prefix.
QUICKBOOKS_CLIENT_ID=YOUR-CLIENT-ID
QUICKBOOKS_CLIENT_SECRET=YOUR-CLIENT-SECRET
# "sandbox" while developing, "production" when live. Selects which Intuit API
# host the app talks to, so a misconfigured value fails loudly rather than
# writing test invoices into your real books.
QUICKBOOKS_ENVIRONMENT=sandbox
# Must match a redirect URI registered on the app's settings page, exactly.
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# Intuit sends webhooks signed with this token (developer.intuit.com > your app
# > Webhooks). Without it, payment notifications are rejected unverified.
QUICKBOOKS_WEBHOOK_TOKEN=YOUR-WEBHOOK-VERIFIER-TOKEN
